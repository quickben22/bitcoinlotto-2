# Copy to keystore.properties (gitignored) and fill in the release upload key.
# storeFile is resolved relative to the repository root.
# After creating a key, export its public certificate for Play Console:
#   keytool -export -rfc -keystore <file>.jks -alias <alias> -file upload_certificate.pem
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
